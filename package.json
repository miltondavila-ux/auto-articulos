{
  "name": "auto-articulos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@tremor/react": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    }
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db",
    "start": "bash start-auto-shutdown.sh",
    "stop": "docker-compose down"
  },
  "devDependencies": {
    "next": "16.3.0-canary.32"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
