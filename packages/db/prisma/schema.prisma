generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  user
}

model User {
  id                                String    @id @default(cuid())
  name                              String?
  firstName                         String?
  lastName                          String?
  phone                             String?
  email                             String    @unique
  passwordHash                      String
  // Guardada cifrada (no en texto plano) además del hash, para que el
  // admin pueda recuperarla y compartirla con la persona invitada — pedido
  // explícito del usuario el 31/7/2026. El login sigue verificando contra
  // passwordHash (bcrypt); este campo nunca se usa para autenticar.
  initialPasswordEncrypted          String?
  role                              UserRole  @default(user)
  monthlyArticleLimit               Int?      @default(300)
  dailyArticleLimit                 Int?      @default(20)
  maxTitlesPerBatch                 Int       @default(20)
  // Encontrado el 2/8/2026: usuarios en Europa (ej. Lidia Capdevila) tienen
  // su cuenta real en 10minutesWebsite.site en vez de .net. El login/las
  // acciones generales funcionan igual en ambos, pero la generación de
  // imagen se ve bien en la vista previa y nunca queda guardada de verdad
  // (mtime=null en el archivo final) cuando el dominio no coincide con el
  // servidor real de la cuenta. "net" (valor por defecto, sin cambios para
  // nadie existente) o "site".
  platformDomain                    String    @default("net")
  // Dominio real elegido durante la primera conexión. Es independiente del
  // servidor de acceso (net/site/tagcrush) y del idioma del panel.
  selectedSiteDomain                String?
  selectedSitePanel                 String?
  siteSelectionConfirmed            Boolean   @default(false)
  // País declarado al CREAR la cuenta (código ISO 3166-1 alpha-2, ej. "ES",
  // "MX") — pedido explícito del usuario, 14/8/2026. Solo se pregunta a las
  // cuentas nuevas (registro de prueba y alta desde Administración); las
  // existentes quedan en null y no cambian. De este valor se deduce
  // automáticamente platformDomain: Europa -> "site", resto del mundo ->
  // "net" (ver apps/web/src/lib/countries.ts).
  country                           String?
  // Idioma en el que la IA debe redactar los artículos de este usuario en
  // 10minutesWebsite (independiente del idioma de la interfaz de esa
  // cuenta, que es lo que causaba selectores de botón rotos — ver
  // apps/worker/src/automation/10minutesWebsite.ts, 4/8/2026). "es" por
  // defecto, sin cambios para nadie existente.
  contentLanguage                   String    @default("es")
  // Texto propio del usuario (ej. firma/aviso legal) que se agrega
  // automáticamente al final del contenido de CADA artículo nuevo — pedido
  // explícito del usuario, 6/8/2026. Null/vacío = no se agrega nada.
  articleSignature                  String?
  // Se actualiza cada vez que termina un análisis de oportunidades (haya
  // encontrado categorías nuevas o no) — permite mostrar "último análisis"
  // y aplicar la espera mínima de 7 días cuando no hay nada nuevo, sin
  // depender de OpportunityGroup.createdAt (que no cambia si esa corrida no
  // creó grupos).
  lastOpportunityAnalysisAt         DateTime?
  // Momento exacto en que el usuario aceptó expresamente el aviso de
  // divulgación de Oportunidades (algoritmo automatizado + IA, sin
  // responsabilidad del administrador sobre las decisiones de
  // publicación) — pedido explícito del usuario, 5/8/2026. Se muestra una
  // sola vez, la primera vez que se entra a Oportunidades; null significa
  // que todavía no lo ha aceptado.
  opportunitiesDisclosureAcceptedAt DateTime?
  createdAt                         DateTime  @default(now())
  // Bloqueo entre procesos (no solo entre "lanes" del mismo proceso): con
  // varios workers de GitHub Actions corriendo en paralelo (31/7/2026,
  // pedido explícito por carga real de ~40 usuarios), el bloqueo en
  // memoria de reservation.ts ya no alcanza -- dos procesos distintos
  // podrían abrir sesión en la MISMA cuenta de 10minutesWebsite a la vez.
  // Este campo es el reemplazo: un "claim" atómico vía UPDATE condicional
  // (ver reservation.ts), con vencimiento automático como red de
  // seguridad si un proceso muere sin liberarlo.
  workerBusyUntil                   DateTime?
  // Control de acceso a publicación en Instagram. Solo el admin puede
  // activarlo por usuario. Default: false (nadie tiene acceso).
  allowInstagramPublishing          Boolean   @default(false)
  // Control de acceso a publicación en LinkedIn. Solo el admin puede
  // activarlo por usuario. Default: false (nadie tiene acceso).
  allowLinkedInPublishing           Boolean   @default(false)
  // Control de acceso a publicación en Threads. Solo el admin puede
  // activarlo por usuario. Default: false (nadie tiene acceso).
  allowThreadsPublishing            Boolean   @default(false)
  allowFacebookPublishing           Boolean   @default(false)
  // Control de acceso a publicación en Pinterest. Solo el admin puede
  // activarlo por usuario. Default: false (nadie tiene acceso).
  allowPinterestPublishing          Boolean   @default(false)
  // Control de acceso a publicación en Tumblr. Solo el admin puede
  // activarlo por usuario. Default: false (nadie tiene acceso).
  allowTumblrPublishing              Boolean   @default(false)
  // Control de acceso a publicación en Bluesky. Solo el admin puede activarlo.
  allowBlueskyPublishing             Boolean   @default(false)
  // Control de acceso a publicación en Mastodon. Solo el admin puede activarlo.
  allowMastodonPublishing            Boolean   @default(false)
  // Control de acceso a publicación de artículos adaptados en DEV.to.
  allowDevToPublishing               Boolean   @default(false)
  // Control de acceso al generador de imágenes con IA para redes sociales
  // (20/8/2026, "Creador de Imágenes para Redes Sociales"). Solo el admin
  // puede activarlo por usuario — es un upsell, no un reemplazo forzado.
  // Default: false = se sigue usando la imagen OG del artículo tal cual,
  // exactamente como hoy. En true, Instagram Story y Reel-image generan la
  // imagen con IA (partiendo de la OG + logo/foto del usuario) en vez de
  // usar la OG sin tocar. No afecta Carrusel/Infografía (ya generan imagen
  // propia, no usan la OG).
  aiImageGenerationEnabled          Boolean   @default(false)
  // Foto de perfil del usuario y logo de su negocio/marca.
  // Se usan como elementos visuales en las publicaciones de redes sociales
  // (carruseles, reels, infografías). Subidas como URLs de Vercel Blob.
  profilePhotoUrl                   String?
  profilePhotoUrl2                  String?
  profilePhotoUrl3                  String?
  businessLogoUrl                   String?
  businessLogoUrl2                  String?
  // Plantilla de prompt personalizada para la generación de imágenes de
  // artículos y redes sociales. Null = usar el prompt por defecto del
  // sistema. Guardado en texto plano (no sensible).
  imagePrompt                       String?
  // Plantilla de prompt personalizada para la generación de infografías
  // de Instagram. Null = usar el prompt por defecto del sistema.
  infographicPrompt                 String?
  // Sistema de prueba gratuita (13/8/2026): cuentas creadas por la propia
  // persona desde el botón "Solicitar prueba" en Login (no por el admin)
  // obtienen 7 días de acceso completo, y después quedan bloqueadas salvo
  // que el admin las desbloquee manualmente. isTrialSignup marca ese origen
  // (para que el admin las identifique y las contacte); trialStartedAt
  // cuenta los 7 días; trialUnlocked es el "check de desbloqueo" manual del
  // admin — en true por defecto para TODOS los usuarios existentes/creados
  // por admin (nunca se bloquean por esto), pero se crea en false para
  // quienes se inscriben solos, así que su acceso depende del período de
  isTrialSignup                     Boolean   @default(false)
  trialStartedAt                    DateTime?
  trialUnlocked                     Boolean   @default(true)
  // Control de visibilidad de módulos para el usuario (13/8/2026).
  // JSON serializado con los IDs de módulos deshabilitados para este usuario
  // (ej. ["oportunidades-redes", "actualizaciones"]). Null = hereda la visibilidad global.
  disabledModules                   String?
  // Disponibilidad de créditos de imagen en 10minutesWebsite (13/8/2026).
  // Si está en false, la cuenta no tiene créditos y se muestra un pop-up con
  // enlace a https://www.10minuteswebsite.com/ayuda para solicitar más créditos.
  hasImageCredits                   Boolean   @default(true)
  defaultPromptId                   String?
  defaultPrompt                     Prompt?   @relation(fields: [defaultPromptId], references: [id], onDelete: SetNull)

  credentials                Credential[]
  runs                       Run[]
  categories                 Category[]
  categorySyncJobs           CategorySyncJob[]
  languages                  Language[]
  languageSyncJobs           LanguageSyncJob[]
  searchIntegrations         SearchIntegration[]
  opportunityGroups          OpportunityGroup[]
  businessProfileIntegration BusinessProfileIntegration?
  threadsIntegration         ThreadsIntegration?
  twitterIntegration         TwitterIntegration?
  linkedinIntegration        LinkedInIntegration?
  instagramIntegration       InstagramIntegration?
  facebookPageIntegration   FacebookPageIntegration?
  pinterestIntegration      PinterestIntegration?
  tumblrIntegration         TumblrIntegration?
  blueskyIntegration         BlueskyIntegration?
  mastodonIntegration         MastodonIntegration?
  devToIntegration           DevToIntegration?
  socialOpportunities        SocialOpportunity[]
  oauthAuthorizationCodes    OAuthAuthorizationCode[]
  oauthAccessTokens          OAuthAccessToken[]
  oauthRefreshTokens         OAuthRefreshToken[]
  trialDomainRegistries      TrialDomainRegistry[]
}

// Credenciales del authorization server propio para el enlace de cuentas MCP.
// Los valores secretos nunca se guardan: codeHash/tokenHash son SHA-256 de
// valores aleatorios que solo se entregan una vez al cliente OAuth.
model OAuthAuthorizationCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  userId        String
  clientId      String
  redirectUri   String
  scopes        String
  resource      String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccessToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  clientId  String
  scopes    String
  resource  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  clientId  String
  scopes    String
  resource  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Conexión OAuth de un usuario con Google Business Profile (antes Google My
// Business) — pedido explícito del usuario, 5/8/2026: cada artículo publicado
// también se convierte en una publicación del perfil de negocio. Mismo patrón
// que SearchIntegration (refresh token cifrado, nunca el access token), pero
// un solo registro por usuario porque solo se elige UNA ubicación a la vez.
model BusinessProfileIntegration {
  id                    String   @id @default(cuid())
  userId                String   @unique
  encryptedRefreshToken String
  // Nulos justo después de conectar: el usuario recién elige la ubicación en
  // un segundo paso en Configuración (mismo patrón que SearchIntegration).
  accountName           String? // "accounts/123..."
  locationName          String? // "accounts/123/locations/456..."
  locationTitle         String? // nombre visible, para mostrarlo en Configuración
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión OAuth 2.0 con Meta Threads API — pedido explícito del usuario,
// 7/8/2026. Almacena el Long-Lived Token cifrado con AES-256-GCM y datos de la
// cuenta conectada para la publicación automática de Hilos tras la divulgación
// del artículo.
model ThreadsIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  threadsUserId        String
  threadsUsername      String?
  accessTokenEncrypted String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión OAuth 2.0 con X (Twitter) API v2 — publicación automática de
// tweets tras la publicación del artículo. Usa OAuth 2.0 PKCE con refresh
// token para mantener la sesión activa.
model TwitterIntegration {
  id                    String   @id @default(cuid())
  userId                String   @unique
  twitterUserId         String
  twitterUsername       String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión OAuth 2.0 con LinkedIn API — publicación automática de posts
// tras la publicación del artículo. Share on LinkedIn es gratuito.
model LinkedInIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  linkedinUserId       String
  linkedinUsername     String?
  accessTokenEncrypted String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión OAuth 2.0 con Instagram Graph API (Meta) — publicación de
// Carousels y Reels usando la Instagram Content Publishing API.
model InstagramIntegration {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  instagramBusinessAccountId String
  instagramUsername          String?
  accessTokenEncrypted       String
  expiresAt                  DateTime
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión de una Página de Facebook administrada por el usuario. Comparte la
// autorización Meta con Instagram, pero mantiene la Página elegida y su token
// separados para publicar oportunidades con su caption específico.
model FacebookPageIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  facebookPageId       String
  facebookPageName     String?
  accessTokenEncrypted String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PinterestIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  pinterestUserId      String?
  accessTokenEncrypted String
  refreshTokenEncrypted String?
  expiresAt            DateTime?
  boardId              String?
  boardName            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión manual de Mastodon: cada usuario puede pertenecer a una instancia
// distinta y su Access Token se guarda cifrado.
model MastodonIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  instanceUrl          String
  username             String?
  displayName          String?
  accessTokenEncrypted String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión OAuth2 con Tumblr para publicar posts con imagen y enlace.
model TumblrIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  blogIdentifier       String
  blogTitle            String?
  accessTokenEncrypted String
  refreshTokenEncrypted String?
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexión de Bluesky mediante handle y App Password cifrada.
model BlueskyIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  handle               String
  encryptedAppPassword String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// API key de DEV.to cifrada para publicar artículos adaptados con canonical URL.
model DevToIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  username             String?
  encryptedApiKey      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchIntegration {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  // Dominio real al que pertenece la conexión; vacío para integraciones
  // históricas aún no asociadas.
  siteDomain            String    @default("")
  encryptedRefreshToken String
  siteUrl               String?
  sitemapUrl            String?
  permissionLevel       String?
  // Resultado real del último intento de enviar el sitemap a Google (el
  // diario automático o el botón manual "Enviar sitemap ahora") — pedido
  // explícito del usuario: poder ver si falló y reintentarlo a mano en vez
  // de depender solo del automático.
  lastSitemapSyncAt     DateTime?
  lastSitemapSyncStatus String?
  lastSitemapSyncError  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, siteDomain])
  @@index([userId])
}

model Credential {
  id                String   @id @default(cuid())
  userId            String
  platform          String   @default("10minutesWebsite")
  encryptedUsername String
  encryptedPassword String
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Category {
  id         String   @id @default(cuid())
  userId     String
  platform   String   @default("10minutesWebsite")
  externalId String
  name       String
  // 10minutesWebsite distingue categorías "regulares" de categorías "de
  // secuencia" (atributo real data-sequence="0"/"1" en el <select> del
  // formulario, visto en vivo el 5/8/2026). Por defecto solo se debe
  // escribir en las regulares; las de secuencia se listan aparte.
  isSequence Boolean  @default(false)
  // "sync" = la trajo el worker leyendo el sitio real; "manual" = la escribió
  // la persona a mano (fallback del wizard cuando la sincronización
  // automática no funciona, ver POST /api/categories). La distinción existe
  // para poder RECONCILIAR sin borrar de más: bug real de producción
  // (15/8/2026, cuentas de Estee Soto y Antonio Aguirre) — como el sync solo
  // hacía upsert y nunca borraba, cualquier categoría guardada alguna vez
  // (de credenciales que después se corrigieron, de un intento fallido, etc.)
  // se quedaba mezclada para siempre con las correctas. Ahora cada
  // sincronización exitosa reemplaza el conjunto "sync" completo y deja las
  // "manual" intactas. Las filas que ya existían al agregar esta columna
  // quedan en "sync" por default: es el default correcto porque la enorme
  // mayoría de las categorías vienen del sitio, y así el próximo sync ya
  // limpia la basura acumulada en vez de perpetuarla.
  source     String   @default("sync")
  // Algunas cuentas (ej. tagcrush, tras un solo login) ofrecen varios
  // "paneles" — sitios distintos con sus propias categorías, elegidos por un
  // selector que NO cambia la URL (el servidor lo guarda en la sesión, visto
  // en vivo el 15/8/2026, cuenta de Estee Soto: paneles "English"/"Español").
  // Se guarda el nombre visible del panel tal cual lo muestra el sitio; ""
  // = cuenta sin esta función (la enorme mayoría, comportamiento sin
  // cambios). No es nullable a propósito: Prisma no admite `null` en una
  // clave única compuesta (@@unique) de forma confiable, ni Postgres lo
  // trata como "igual" entre filas — visto al implementar esto, 15/8/2026.
  panel      String   @default("")
  // Dominio confirmado para esta categoría. Vacío conserva compatibilidad
  // con categorías históricas aún no vinculadas.
  siteDomain String   @default("")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs              Run[]
  opportunityGroups OpportunityGroup[]

  @@unique([userId, platform, panel, externalId])
}

// Idiomas reales que ofrece el selector "Lucy habla diferentes idiomas..."
// dentro del modal de generación de 10minutesWebsite (visto en vivo el
// 5/8/2026) — se sincronizan igual que las categorías, en vez de asumir una
// lista fija, porque cada cuenta puede tener opciones distintas.
model Language {
  id         String   @id @default(cuid())
  userId     String
  platform   String   @default("10minutesWebsite")
  externalId String
  name       String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalId])
}

model LanguageSyncJob {
  id           String             @id @default(cuid())
  userId       String
  status       CategorySyncStatus @default(pending)
  errorMessage String?
  createdAt    DateTime           @default(now())
  finishedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model OpportunityGroup {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  rationale   String?
  impressions Float    @default(0)
  clicks      Float    @default(0)
  createdAt   DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  titles   OpportunityTitle[]

  @@unique([userId, categoryId])
  @@index([userId, createdAt])
}

model OpportunityTitle {
  id        String   @id @default(cuid())
  groupId   String
  text      String
  rationale String?
  createdAt DateTime @default(now())

  group OpportunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

enum CategorySyncStatus {
  pending
  running
  success
  error
}

model CategorySyncJob {
  id           String             @id @default(cuid())
  userId       String
  status       CategorySyncStatus @default(pending)
  errorMessage String?
  createdAt    DateTime           @default(now())
  finishedAt   DateTime?
  // "sync" (default, comportamiento histórico: descarga categorías) o
  // "detect": solo inicia sesión y lee los paneles/sitios reales de la
  // cuenta (ver listPanelLabels en el worker), sin tocar categorías. Lo usa
  // el wizard para mostrar los sitios reales antes de que la persona elija
  // uno, en vez de dejarlo escribir un dominio a mano sin verificar.
  mode           String   @default("sync")
  // Etiquetas reales de panel encontradas por un job mode="detect" exitoso.
  // Vacío = la cuenta no tiene selector de paneles (un solo sitio real).
  detectedPanels String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum RunStatus {
  pending
  running
  success
  halted
  cancelled
}

model Run {
  id              String    @id @default(cuid())
  userId          String
  categoryId      String
  status          RunStatus @default(pending)
  disableIndexing Boolean   @default(false)
  // Idioma elegido para ESTE lote, al pegar los títulos en Publicar o al
  // ejecutar desde Oportunidades (pedido explícito del usuario, 7/8/2026: el
  // idioma es una propiedad del artículo, no del usuario). Guarda el value real
  // del selector de 10minutesWebsite, igual que User.contentLanguage — ver
  // fetchLanguages() en el worker. NULL = usar el idioma configurado del
  // usuario, que es lo que pasa con todas las corridas anteriores a este campo.
  contentLanguage String?
  promptId        String?
  prompt          Prompt?   @relation(fields: [promptId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  titles   Title[]

  @@index([userId])
}

enum TitleStatus {
  pending
  processing
  success
  error
  cancelled
}

model Title {
  id                     String      @id @default(cuid())
  runId                  String
  text                   String
  order                  Int
  status                 TitleStatus @default(pending)
  attempts               Int         @default(0)
  articleUrl             String?
  finalTitle             String?
  errorMessage           String?
  // Fecha original de la oportunidad, copiada al convertirla en un Run.
  // NULL para publicaciones creadas directamente desde el módulo Publicar.
  opportunityCreatedAt   DateTime?
  // Momento en que el worker confirmó que el artículo quedó publicado.
  // Se mantiene separado de processedAt, que también se usa para errores.
  publishedAt            DateTime?
  processedAt            DateTime?
  googleIndexingStatus   String?
  googleIndexingMessage  String?
  googleIndexingAt       DateTime?
  // Bing sí permite pedir indexación instantánea de cualquier URL
  // (SubmitUrl), a diferencia de Google que solo lo permite para tipos de
  // contenido muy específicos — pedido explícito del usuario, 5/8/2026.
  bingIndexingStatus     String?
  bingIndexingMessage    String?
  bingIndexingAt         DateTime?
  // Se marca solo cuando el envío diario del sitemap a Google Search
  // Console fue confirmado exitoso (respuesta ok de la API) — nunca en un
  // intento fallido, pendiente o sin verificar.
  lastSitemapSentAt      DateTime?
  // Resumen/excerpt real del artículo (el mismo texto que ya se usa para
  // armar el prompt de imagen, ver apps/worker/src/imagePrompt.ts), guardado
  // en el momento de publicar para poder reusarlo después al armar la
  // publicación de Google Business Profile sin tener que volver a abrir el
  // artículo. Null en artículos publicados antes de este campo.
  summary                String?
  // Seguimiento de publicación automática en Meta Threads — pedido explícito
  // del usuario, 7/8/2026. Se llena cuando el worker publica el artículo y
  // envía el Hilo a Meta Threads en 2 pasos (Container API).
  threadsPublishStatus   String? // "pending" | "success" | "error" | "not_configured" | "skipped"
  threadsPostId          String?
  threadsPublishError    String?
  threadsPublishAt       DateTime?
  twitterPublishStatus   String? // "pending" | "success" | "error" | "not_configured" | "skipped"
  twitterPostId          String?
  twitterPublishError    String?
  twitterPublishAt       DateTime?
  linkedinPublishStatus  String? // "pending" | "success" | "error" | "not_configured" | "skipped"
  linkedinPostId         String?
  linkedinPublishError   String?
  linkedinPublishAt      DateTime?
  instagramPublishStatus String? // "pending" | "success" | "error" | "not_configured" | "skipped"
  instagramPostId        String?
  instagramPublishError  String?
  instagramPublishAt     DateTime?

  run                 Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  events              TitleEvent[]
  businessProfilePost BusinessProfilePost?
  socialOpportunities SocialOpportunity[]

  @@index([runId, status])
}

// Historial de publicaciones enviadas a Google Business Profile — un
// registro por artículo publicado, con el texto exacto enviado, la fecha,
// la ubicación usada, el estado y la respuesta/error real de Google. Pedido
// explícito del usuario, 5/8/2026.
model BusinessProfilePost {
  id             String    @id @default(cuid())
  titleId        String    @unique
  summary        String
  ctaUrl         String
  imageUrl       String?
  status         String    @default("pending") // pending, sent, error, rejected
  googleResponse String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
}

model TitleEvent {
  id        String   @id @default(cuid())
  titleId   String
  message   String
  createdAt DateTime @default(now())

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId, createdAt])
}

// Configuración global del sistema (ej. App ID y App Secret de Meta Threads)
// guardada cifrada con AES-256-GCM para que el usuario o administrador pueda
// configurar las llaves generales de la API directamente desde la plataforma.
model SystemSetting {
  key            String   @id
  encryptedValue String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model SocialOpportunity {
  id            String    @id @default(cuid())
  userId        String
  titleId       String?
  articleUrl    String
  articleTitle  String
  platform      String // "threads" | "linkedin" | "x" | "instagram" | "facebook" | "pinterest" | "tumblr"
  suggestedText String    @db.Text
  status        String    @default("pending") // "pending" | "published" | "skipped"
  progressPercent Int       @default(0)
  progressStage   String?
  startedAt       DateTime?
  finishedAt      DateTime?
  postId        String?
  errorLog      String?   @db.Text
  skipReason    String?
  // Columna real en la base desde la migración 20260811000000 pero nunca
  // declarada en este schema — Prisma Client no podía leerla ni escribirla
  // pese a existir en la tabla. Corregido 22/8/2026 al agregar el guardado
  // del prompt/imagen de IA que pidió Milton.
  imageUrl      String?
  // Prompt EXACTO que se le mandó al generador de imagen (línea cruda del
  // Director Creativo, sin modificar) — para que Milton pueda ver en el
  // histórico qué se usó realmente en cada publicación, sin tener que
  // reconstruirlo desde los logs de GitHub Actions. Pedido explícito de
  // Milton, 22/8/2026.
  aiImagePrompt String?   @db.Text
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title? @relation(fields: [titleId], references: [id], onDelete: SetNull)
}

// Registro global y durable de mejoras y arreglos visibles para los usuarios.
// Es la fuente de verdad de /dashboard/actualizaciones y, posteriormente, del
// asistente de ayuda. sourceCommit permite que el automatismo no duplique la
// entrada correspondiente a un mismo cambio de código.
model ProductUpdate {
  id           String   @id @default(cuid())
  date         DateTime
  title        String
  category     String
  summary      String
  example      String
  // Ruta interna del módulo al que debe ir el usuario para usar o comprobar
  // esta novedad. Nunca se aceptan enlaces externos desde el automatismo.
  modulePath   String?
  sourceCommit String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// Registro histórico de dominios y cuentas de 10minutesWebsite vinculados a
// pruebas gratuitas (Trials). Impide que un mismo cliente cree múltiples
// cuentas de prueba con correos distintos para evadir la expiración de su trial.
model TrialDomainRegistry {
  id               String   @id @default(cuid())
  userId           String
  normalizedDomain String?  // Dominio raíz limpio (ej. "mimarcareal.com")
  accountUsername  String?  // Username de 10minutesWebsite (en minúsculas y limpio)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([normalizedDomain])
  @@index([accountUsername])
}

model Prompt {
  id        String   @id @default(cuid())
  name      String   @unique
  prompt    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]
  users     User[]
}
