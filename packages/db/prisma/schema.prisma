generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  user
}

model User {
  id                       String   @id @default(cuid())
  name                     String?
  firstName                String?
  lastName                 String?
  phone                    String?
  email                    String   @unique
  passwordHash             String
  // Guardada cifrada (no en texto plano) además del hash, para que el
  // admin pueda recuperarla y compartirla con la persona invitada — pedido
  // explícito del usuario el 31/7/2026. El login sigue verificando contra
  // passwordHash (bcrypt); este campo nunca se usa para autenticar.
  initialPasswordEncrypted String?
  role                     UserRole @default(user)
  monthlyArticleLimit      Int?
  createdAt                DateTime @default(now())

  credentials      Credential[]
  runs             Run[]
  categories       Category[]
  categorySyncJobs CategorySyncJob[]
}

model Credential {
  id                String   @id @default(cuid())
  userId            String
  platform          String   @default("10minutesWebsite")
  encryptedUsername String
  encryptedPassword String
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Category {
  id         String   @id @default(cuid())
  userId     String
  platform   String   @default("10minutesWebsite")
  externalId String
  name       String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs Run[]

  @@unique([userId, platform, externalId])
}

enum CategorySyncStatus {
  pending
  running
  success
  error
}

model CategorySyncJob {
  id           String             @id @default(cuid())
  userId       String
  status       CategorySyncStatus @default(pending)
  errorMessage String?
  createdAt    DateTime           @default(now())
  finishedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum RunStatus {
  pending
  running
  success
  halted
  cancelled
}

model Run {
  id              String    @id @default(cuid())
  userId          String
  categoryId      String
  status          RunStatus @default(pending)
  disableIndexing Boolean   @default(false)
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  titles   Title[]

  @@index([userId])
}

enum TitleStatus {
  pending
  processing
  success
  error
  cancelled
}

model Title {
  id           String      @id @default(cuid())
  runId        String
  text         String
  order        Int
  status       TitleStatus @default(pending)
  attempts     Int         @default(0)
  articleUrl   String?
  finalTitle   String?
  errorMessage String?
  processedAt  DateTime?

  run    Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  events TitleEvent[]

  @@index([runId, status])
}

model TitleEvent {
  id        String   @id @default(cuid())
  titleId   String
  message   String
  createdAt DateTime @default(now())

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId, createdAt])
}
