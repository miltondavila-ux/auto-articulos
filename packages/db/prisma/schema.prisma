generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  user
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  firstName                String?
  lastName                 String?
  phone                    String?
  email                    String    @unique
  passwordHash             String
  // Guardada cifrada (no en texto plano) además del hash, para que el
  // admin pueda recuperarla y compartirla con la persona invitada — pedido
  // explícito del usuario el 31/7/2026. El login sigue verificando contra
  // passwordHash (bcrypt); este campo nunca se usa para autenticar.
  initialPasswordEncrypted String?
  role                     UserRole  @default(user)
  monthlyArticleLimit      Int?      @default(300)
  dailyArticleLimit        Int?      @default(95)
  maxTitlesPerBatch        Int       @default(20)
  // Encontrado el 2/8/2026: usuarios en Europa (ej. Lidia Capdevila) tienen
  // su cuenta real en 10minutesWebsite.site en vez de .net. El login/las
  // acciones generales funcionan igual en ambos, pero la generación de
  // imagen se ve bien en la vista previa y nunca queda guardada de verdad
  // (mtime=null en el archivo final) cuando el dominio no coincide con el
  // servidor real de la cuenta. "net" (valor por defecto, sin cambios para
  // nadie existente) o "site".
  platformDomain           String    @default("net")
  // Idioma en el que la IA debe redactar los artículos de este usuario en
  // 10minutesWebsite (independiente del idioma de la interfaz de esa
  // cuenta, que es lo que causaba selectores de botón rotos — ver
  // apps/worker/src/automation/10minutesWebsite.ts, 4/8/2026). "es" por
  // defecto, sin cambios para nadie existente.
  contentLanguage          String    @default("es")
  createdAt                DateTime  @default(now())
  // Bloqueo entre procesos (no solo entre "lanes" del mismo proceso): con
  // varios workers de GitHub Actions corriendo en paralelo (31/7/2026,
  // pedido explícito por carga real de ~40 usuarios), el bloqueo en
  // memoria de reservation.ts ya no alcanza -- dos procesos distintos
  // podrían abrir sesión en la MISMA cuenta de 10minutesWebsite a la vez.
  // Este campo es el reemplazo: un "claim" atómico vía UPDATE condicional
  // (ver reservation.ts), con vencimiento automático como red de
  // seguridad si un proceso muere sin liberarlo.
  workerBusyUntil          DateTime?

  credentials        Credential[]
  runs               Run[]
  categories         Category[]
  categorySyncJobs   CategorySyncJob[]
  languages          Language[]
  languageSyncJobs   LanguageSyncJob[]
  searchIntegrations SearchIntegration[]
  opportunityGroups  OpportunityGroup[]
}

model SearchIntegration {
  id                    String   @id @default(cuid())
  userId                String
  provider              String
  encryptedRefreshToken String
  siteUrl               String?
  sitemapUrl            String?
  permissionLevel       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Credential {
  id                String   @id @default(cuid())
  userId            String
  platform          String   @default("10minutesWebsite")
  encryptedUsername String
  encryptedPassword String
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Category {
  id         String   @id @default(cuid())
  userId     String
  platform   String   @default("10minutesWebsite")
  externalId String
  name       String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs              Run[]
  opportunityGroups OpportunityGroup[]

  @@unique([userId, platform, externalId])
}

// Idiomas reales que ofrece el selector "Lucy habla diferentes idiomas..."
// dentro del modal de generación de 10minutesWebsite (visto en vivo el
// 5/8/2026) — se sincronizan igual que las categorías, en vez de asumir una
// lista fija, porque cada cuenta puede tener opciones distintas.
model Language {
  id         String   @id @default(cuid())
  userId     String
  platform   String   @default("10minutesWebsite")
  externalId String
  name       String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalId])
}

model LanguageSyncJob {
  id           String             @id @default(cuid())
  userId       String
  status       CategorySyncStatus @default(pending)
  errorMessage String?
  createdAt    DateTime           @default(now())
  finishedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model OpportunityGroup {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  rationale   String?
  impressions Float    @default(0)
  clicks      Float    @default(0)
  createdAt   DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  titles   OpportunityTitle[]

  @@unique([userId, categoryId])
  @@index([userId, createdAt])
}

model OpportunityTitle {
  id        String   @id @default(cuid())
  groupId   String
  text      String
  rationale String?
  createdAt DateTime @default(now())

  group OpportunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

enum CategorySyncStatus {
  pending
  running
  success
  error
}

model CategorySyncJob {
  id           String             @id @default(cuid())
  userId       String
  status       CategorySyncStatus @default(pending)
  errorMessage String?
  createdAt    DateTime           @default(now())
  finishedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum RunStatus {
  pending
  running
  success
  halted
  cancelled
}

model Run {
  id              String    @id @default(cuid())
  userId          String
  categoryId      String
  status          RunStatus @default(pending)
  disableIndexing Boolean   @default(false)
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  titles   Title[]

  @@index([userId])
}

enum TitleStatus {
  pending
  processing
  success
  error
  cancelled
}

model Title {
  id                    String      @id @default(cuid())
  runId                 String
  text                  String
  order                 Int
  status                TitleStatus @default(pending)
  attempts              Int         @default(0)
  articleUrl            String?
  finalTitle            String?
  errorMessage          String?
  processedAt           DateTime?
  googleIndexingStatus  String?
  googleIndexingMessage String?
  googleIndexingAt      DateTime?
  // Se marca solo cuando el envío diario del sitemap a Google Search
  // Console fue confirmado exitoso (respuesta ok de la API) — nunca en un
  // intento fallido, pendiente o sin verificar.
  lastSitemapSentAt     DateTime?

  run    Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  events TitleEvent[]

  @@index([runId, status])
}

model TitleEvent {
  id        String   @id @default(cuid())
  titleId   String
  message   String
  createdAt DateTime @default(now())

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId, createdAt])
}
