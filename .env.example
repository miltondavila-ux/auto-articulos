# Base de datos
# En local, DATABASE_URL y DIRECT_URL pueden ser la misma cadena.
# En producción serverless, DATABASE_URL usa el transaction pooler; Prisma
# Migrate debe usar una conexión compatible con migraciones en DIRECT_URL.
DATABASE_URL="postgresql://autoarticulos:autoarticulos@localhost:5432/autoarticulos?schema=public"
DIRECT_URL="postgresql://autoarticulos:autoarticulos@localhost:5432/autoarticulos?schema=public"

# Firma de sesión del dashboard
SESSION_SECRET="genera-un-valor-aleatorio-largo-aqui"

# Clave de cifrado AES-256 para las credenciales de 10minutesWebsite.
# Debe ser una cadena base64 que decodifique a EXACTAMENTE 32 bytes.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# Disparo bajo demanda del workflow del worker
GITHUB_ACTIONS_TOKEN=""
GITHUB_REPO="propietario/repositorio"

# Google Search Console OAuth/API
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="http://localhost:3000/api/search-integrations/google/callback"

# Generación de FAQ, prompts de imagen y análisis de Oportunidades
OPENAI_API_KEY=""

# Google Business Profile OAuth (reusa el mismo cliente de arriba, solo
# necesita un redirect URI propio) + Vercel Blob para alojar la imagen que
# se le envía a Google (localPosts solo acepta una URL pública, no bytes).
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI="http://localhost:3000/api/business-profile/callback"
BLOB_READ_WRITE_TOKEN=""

# Bing Webmaster Tools OAuth (Settings > API Access > OAuth Client en
# bing.com/webmasters)
BING_WEBMASTER_CLIENT_ID=""
BING_WEBMASTER_CLIENT_SECRET=""
BING_WEBMASTER_REDIRECT_URI="http://localhost:3000/api/search-integrations/bing/callback"

# Primer usuario admin sembrado en la base de datos
ADMIN_EMAIL="tu-correo@ejemplo.com"
ADMIN_PASSWORD="cambia-esto"
